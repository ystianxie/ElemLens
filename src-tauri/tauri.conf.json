{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElemLens",
  "version": "0.1.0",
  "identifier": "dev.elemlens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "觅元 ElemLens",
        "width": 1320,
        "height": 860,
        "minWidth": 1050,
        "minHeight": 680,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon2.png"
    ]
  }
}
